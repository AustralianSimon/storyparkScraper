#Required Variables
SP_USER=#Your storypark username here
SP_PASS=#your storypark password here
#Optional Variables
PAGE_TIMEOUT=50000 #milliseconds to wait for page to load, defaults 50000
ALL_IMAGES=1 #set to 1 to download all photos (best for first time run) remove or set to 0 to only download latest
IMAGE_IDLE=200000 #milliseconds to wait for images to load, defaults 200000
AUTH_TIMEOUT=600 #seconds to wait for you to complete captcha/MFA, defaults 600
AUTH_ASSIST_PORT=8000 #port for the captcha/MFA login assist page, defaults 8000
HEADLESS=1 #set to 0 to show the browser window (non docker only), defaults 1
SESSION_FILE=session/storage_state.json #where the login session is saved, defaults session/storage_state.json
